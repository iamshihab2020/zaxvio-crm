# Supabase (Storage + Realtime only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres.xxxxx:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Fastify API
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=your-secret-at-least-32-characters-long

# Super Admin Seed
ADMIN_SEED_EMAIL=admin@yourdomain.com
ADMIN_SEED_PASSWORD=change-me-immediately

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# Resend (Email)
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Lemon Squeezy (Billing)
LEMON_SQUEEZY_API_KEY=your-ls-api-key
LEMON_SQUEEZY_WEBHOOK_SECRET=your-ls-webhook-secret
LEMON_SQUEEZY_STORE_ID=your-store-id
LEMON_SQUEEZY_VARIANT_ID=your-variant-id

# Mapbox
MAPBOX_ACCESS_TOKEN=your-mapbox-token
