# ──────────────────────────────────────────────────────────────
# BACKEND ENV — monorepo root .env
#
# Loaded by:
#   • apps/api          → apps/api/src/lib/env.ts (Zod-validated, fails fast)
#   • packages/database → drizzle.config.ts (db:generate / db:push / db:migrate)
#
# The Next.js app does NOT read this file. Next.js only loads .env* from its
# own directory — see apps/web/.env.example.
#
# Setup:  cp .env.example .env  &&  cp apps/web/.env.example apps/web/.env.local
# ──────────────────────────────────────────────────────────────

# ── Database (Drizzle ORM) ────────────────────────────────────
# Use a POOLED connection string. The client sets `prepare: false`
# (packages/database/src/client.ts), which pooled endpoints require.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Better Auth ───────────────────────────────────────────────
# Minimum 32 characters — the API refuses to boot below this.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars

# ── Fastify API ───────────────────────────────────────────────
PORT=4000
API_BASE_URL=http://localhost:4000

# ── Shared with the frontend ──────────────────────────────────
# Must be kept identical in apps/web/.env.local.
FRONTEND_URL=http://localhost:3000

# ── Cloudflare R2 (object storage) ────────────────────────────
# Two buckets, because public-vs-private is a per-bucket setting in R2:
#   public  → job-attachments/, logos/   served straight to the browser
#   private → invoices/, quotes/         streamed through the API only
# Putting PDFs in the public bucket would expose them to anyone guessing a path.
# R2_PUBLIC_URL must match NEXT_PUBLIC_R2_PUBLIC_URL in apps/web/.env.local.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_BUCKET=zaxvio-public
R2_PRIVATE_BUCKET=zaxvio-private
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ── Email (Resend) ────────────────────────────────────────────
# Optional: leave RESEND_API_KEY blank to disable sending (calls no-op with a warning).
# If it IS set, RESEND_FROM_EMAIL is required and its domain must be
# verified in your Resend dashboard, or every send fails with a 403.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-verified-domain.com

# ── Super Admin Seed (used by `pnpm seed:admin`) ──────────────
# Password policy: min 12 chars, uppercase + lowercase + number.
ADMIN_SEED_EMAIL=admin@your-verified-domain.com
ADMIN_SEED_PASSWORD=
