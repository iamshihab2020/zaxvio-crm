# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fastify API
PORT=4000
API_BASE_URL=http://localhost:4000
JWT_SECRET=your-jwt-secret
ADMIN_JWT_SECRET=your-admin-jwt-secret

# Super Admin Seed
ADMIN_SEED_EMAIL=admin@yourdomain.com
ADMIN_SEED_PASSWORD=change-me-immediately

# Next.js
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# Resend (Email)
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Lemon Squeezy (Billing)
LEMON_SQUEEZY_API_KEY=your-ls-api-key
LEMON_SQUEEZY_WEBHOOK_SECRET=your-ls-webhook-secret
LEMON_SQUEEZY_STORE_ID=your-store-id
LEMON_SQUEEZY_VARIANT_ID=your-variant-id

# Mapbox
MAPBOX_ACCESS_TOKEN=your-mapbox-token
