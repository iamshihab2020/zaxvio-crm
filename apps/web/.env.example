# Frontend env — copy this file to apps/web/.env.local
#
#   cp apps/web/.env.example apps/web/.env.local
#
# Why a second env file? Next.js only reads .env* from its OWN folder
# (apps/web). It never reads the monorepo root .env — that one belongs to
# the Fastify API and the database package. So the frontend needs its own.
#
# Rule of thumb:
#   NEXT_PUBLIC_*  -> sent to the browser. Never put a secret here.
#   everything else -> server-only (route handlers, sitemap, metadata).

# --- Required ---------------------------------------------------

# Where the BROWSER should reach the API.
#
# Locally that is the API itself. In production set this to your own public URL
# (the same value as FRONTEND_URL below) — next.config.mjs then rewrites
# /api/auth/* and /events through to API_INTERNAL_URL.
#
# Why: Better Auth's session cookie is set by the API. If the browser called the
# API on a different domain, that cookie would be third-party, and Safari and
# Firefox drop those — sign-in appears to work and the session never persists.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Where the SERVER should reach the API — server actions, and the upstream for
# the rewrites above. No cookie policy applies here, so this is the API's real
# address (e.g. https://zaxvio-api.onrender.com).
# Leave blank locally: it falls back to NEXT_PUBLIC_API_URL.
# REQUIRED in production — `next build` fails without it rather than shipping a
# rewrite that loops back to this app.
API_INTERNAL_URL=

# This app's own public URL. Used by sitemap.ts, robots.ts, page metadata,
# and the settings/share page.
# Must match FRONTEND_URL in the root .env — the API only allows this origin through CORS.
FRONTEND_URL=http://localhost:3000

# --- Optional ---------------------------------------------------

# Cloudflare R2 public bucket base URL — renders job photos and tenant logos.
# Must match R2_PUBLIC_URL in the root .env.
# Leave blank until R2 is provisioned; images then render blank rather than breaking.
NEXT_PUBLIC_R2_PUBLIC_URL=

# Groq API key for the AI chatbot. Server-only — deliberately not NEXT_PUBLIC_.
# Delete this line (or leave it blank) to run without the chatbot; the chat
# endpoint then returns "AI assistant is not configured" instead of failing.
GROQ_API_KEY=

# Shared secret with the API, so public booking traffic is rate-limited per
# visitor instead of per Next server. Must EXACTLY match INTERNAL_PROXY_SECRET
# in the root .env. Server-only — deliberately not NEXT_PUBLIC_.
# Leave blank to keep the old shared-bucket behaviour.
INTERNAL_PROXY_SECRET=
